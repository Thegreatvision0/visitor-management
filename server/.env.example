# Copy to .env and adjust.
MONGODB_URI=mongodb://127.0.0.1:27017/noormahal
PORT=5000
# Long random string — used to sign login tokens. CHANGE THIS in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
# All dates (arrivals, attendance, "today") are computed in this time zone.
TZ=Asia/Kolkata
# When the database is empty on start-up, load the sample data and demo users.
SEED_ON_EMPTY=true
# Password given to the demo users created by the seed.
SEED_PASSWORD=Noormahal@123
# Allowed browser origin(s) in development, comma-separated.
CORS_ORIGIN=http://localhost:5173
# Public HTTPS address (e.g. https://nurmahal.djjs.org). Guest registration links use it, so they open on any phone.
# Leave empty until the Cloudflare Tunnel is set up - links then use the address the host is browsing.
PUBLIC_URL=
